# URL pubblico del sito, usato per metadataBase, Open Graph e sitemap.xml/robots.txt.
# In produzione su Vercel puoi usare la variabile automatica ${VERCEL_PROJECT_PRODUCTION_URL}
# oppure impostare direttamente il tuo dominio.
NEXT_PUBLIC_SITE_URL=https://tuodominio.com

# Endpoint del servizio esterno per il form contatti (es. Formspree o Web3Forms).
# Esempio Formspree: https://formspree.io/f/xxxxxxxx
# Esempio Web3Forms:  https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/your-form-id
